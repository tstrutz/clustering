{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CLUSTERING_BUILD_BENCHMARK": "0",
        "CLUSTERING_BUILD_TESTS": "0",
        "CLUSTERING_USE_CPM": "0",
        "CLUSTERING_BUILD_DEMO": "0"
      }
    },
    {
      "name": "benchmark",
      "hidden": true,
      "cacheVariables": {
        "CLUSTERING_BUILD_BENCHMARK": "1"
      }
    },
    {
      "name": "tests",
      "hidden": true,
      "cacheVariables": {
        "CLUSTERING_BUILD_TESTS": "1"
      }
    },
    {
      "name": "python",
      "hidden": true,
      "cacheVariables": {
        "CLUSTERING_CREATE_PYTHON_BINDINGS": "1"
      }
    },
    {
      "name": "conan",
      "hidden": true,
      "cacheVariables": {
        "CONAN_HOST_PROFILE": "default;auto-cmake",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "./cmake/conan_provider.cmake"
      }
    },
    {
      "name": "cpm",
      "hidden": true,
      "cacheVariables": {
        "CLUSTERING_USE_CPM": "1",
        "CONAN_HOST_PROFILE": "default;auto-cmake",
        "CMAKE_PROJECT_TOP_LEVEL_INCLUDES": "./cmake/conan_provider.cmake"
      }
    },
    {
      "name": "default-testing",
      "inherits": ["tests", "benchmark", "default"]
    },
    {
      "name": "default-python",
      "inherits": ["python", "default"]
    },
    {
      "name": "default-all",
      "inherits": ["tests", "benchmark", "python", "default"]
    },
    {
      "name": "default-testing-conan",
      "inherits": ["conan", "tests", "benchmark", "default"]
    },
    {
      "name": "default-conan",
      "inherits": ["conan", "default"]
    },
    {
      "name": "default-python-conan",
      "inherits": ["conan", "python", "default"]
    },
    {
      "name": "default-all-conan",
      "inherits": ["conan", "tests", "benchmark", "python", "default"]
    }
  ],
  "buildPresets": [
  {
    "name": "default-conan",
    "configurePreset": "default-conan",
    "targets": "install",
    "configuration": "Release"
  },
  {
    "name": "default-testing-conan",
    "configurePreset": "default-testing-conan",
    "targets": "install",
    "configuration": "Release"
  },
  {
    "name": "default-python-conan",
    "configurePreset": "default-testing-conan",
    "targets": "install",
    "configuration": "Release"
  },
  {
    "name": "default-all-conan",
    "configurePreset": "default-testing-conan",
    "targets": "install",
    "configuration": "Release"
  }
 ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default-testing",
      "configuration": "Release",
      "output": {"outputOnFailure": true},
      "execution": {"noTestsAction": "error"}
    }
  ]
}